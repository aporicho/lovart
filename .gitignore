# v2 gitignore

# Go
dist/
/lovart
*.exe
*.test
*.out

# Extension
node_modules/
extension/dist/
extension/*.zip

# Runtime (generated)
/downloads/
/runs/
.lovart/
.lovart-chrome-profile/
.mitmproxy/

# Local capture debugging artifacts. Existing tracked captures remain tracked.
/captures/*
/captures_backup/*
!/captures/.gitkeep
!/captures_backup/.gitkeep

# OS
.DS_Store
.env
